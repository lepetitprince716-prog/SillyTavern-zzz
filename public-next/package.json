{
    "name": "sillytavern-next",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Next-generation SillyTavern frontend. React 19 + TypeScript + Vite + Tailwind CSS v4.",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "build:only": "vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src"
    },
    "dependencies": {
        "@tanstack/react-query": "^5.102.8",
        "clsx": "^2.1.1",
        "dompurify": "^3.4.15",
        "lucide-react": "^1.43.0",
        "marked": "^18.0.12",
        "radix-ui": "^1.6.7",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^8.3.1",
        "tailwind-merge": "^3.6.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^24.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react-swc": "^4.3.3",
        "eslint": "^10.10.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.6",
        "globals": "^17.12.0",
        "jsdom": "^30.0.1",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.2.2",
        "vitest": "^5.0.0"
    }
}
